SHORTENER_TABLE_NAME=example-short-links
SHORTENER_API_KEY=replace-with-a-secret-value
SHORTENER_DEFAULT_TTL_DAYS=30

# CDK context can be supplied from CLI, CI secrets, or an ignored local config.
# Example:
# pnpm cdk deploy \
#   -c domainName=example.com \
#   -c hostedZoneDomain=example.com \
#   -c hostedZoneId=Z00000000000000000000 \
#   -c certificateArn=arn:aws:acm:us-east-1:123456789012:certificate/example
